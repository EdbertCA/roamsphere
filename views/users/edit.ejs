<% layout('/layout/boilerplate') %>
<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-7 col-xl-6">
      <div class="mb-4 text-center">
        <h1 class="fw-bold mb-2">Edit Profile</h1>
        <p class="text-muted">
          Update your profile to the next level
        </p>
        <% if (foundUser.avatar && foundUser.avatar.url) { %>
          <img 
            src="<%= foundUser.avatar.url %>" 
            class="profile-avatar-img" 
            alt="<%= foundUser.username %>'s profile image"
          >
        <% } else { %>
          <i class="bi bi-person-circle profile-avatar-icon"></i>
        <% } %>
      </div>
      <div class="bg-light rounded-4 p-3 p-md-4 shadow-sm">
        <form action="/users/<%=foundUser._id%>?_method=PUT" method="POST" novalidate class="validated-form"
          enctype="multipart/form-data"
          >
          <div class="mb-3">
            <label class="form-label" for="username">Username</label>
            <input class="form-control" type="text" id="username" name="user[username]" value="<%=foundUser.username%>"
              required>
            <div class="valid-feedback">
              Looks good!
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="bio">Bio</label>
            <input class="form-control" type="text" id="bio" name="user[bio]" value="<%=foundUser.bio%>"
              required>
            <div class="valid-feedback">
              Looks good!
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="location">Location</label>
            <input class="form-control" type="text" id="location" name="user[location]" value="<%=foundUser.location%>"
              required>
            <div class="valid-feedback">
              Looks good!
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium" for="avatar">Profile image</label>
            <input 
              class="form-control" 
              type="file" 
              id="avatar" 
              name="avatar"
            >
            <div class="form-text">
              Upload a photo to personalize your profile.
            </div>
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary flex-grow-1">
              Save Changes
            </button>
            <a href="/users/<%= foundUser._id %>" class="btn btn-outline-secondary">
              Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>