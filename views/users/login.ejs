<% layout('/layout/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/form.css">
<div class="wrapper">
  <div class="container my-auto">
    <div class="row min-vh-50 rounded-3 overflow-hidden">
    <div class="col-md-5 col-lg-6 d-none d-md-block login-bg-image">
    </div>
    <div class="col-md-7 col-lg-6 d-flex align-items-center justify-content-center bg-light px-3 py-5">
      <div class="card border-0 bg-transparent w-100 login-card-custom">
        <div class="card-body">
          <h2 class="card-title fw-bold text-center mb-3">Welcome Back</h2>
          <form action="/login" method="post" class="validated-form" novalidate>
            <div class="mb-3">
              <label class="form-label fw-semibold" for="username">Username</label>
              <input class="form-content form-control form-control-lg input-rounded" type="text" id="username" name="username" required>
              <div class="valid-feedback">
                Looks good!
              </div>
            </div>
            <div class="mb-4">
              <label class="form-label fw-semibold" for="password">Password</label>
              <input class="form-content form-control form-control-lg input-rounded" type="password" id="password" name="password" required>
              <div class="valid-feedback">
                Looks good!
              </div>
            </div>
            <button class="btn btn-dark btn-lg w-100 fw-semibold btn-rounded">Login</button>
          </form>
          <p class="text-center mt-3 mb-0 text-muted">
            New to RoamSphere? <a href="/register" class="text-dark fw-semibold">Sign Up</a>
          </p>
        </div>
      </div>
    </div>
    </div>
  </div>
</div>