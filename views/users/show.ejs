<% layout('/layout/boilerplate') %>
<div class="row">
  <div class="col-12">
    <div class="bg-light rounded-4 p-4 p-md-5 shadow-sm">
      <div class="d-flex flex-column flex-md-row align-items-center gap-4">
        
        <% if (foundUser.avatar && foundUser.avatar.url) { %>
          <img 
            src="<%= foundUser.avatar.url %>" 
            class="profile-avatar-img" 
            alt="<%= foundUser.username %>'s profile image"
          >
        <% } else { %>
          <i class="bi bi-person-circle profile-avatar-icon"></i>
        <% } %>

        <div class="text-center text-md-start flex-grow-1">
          <h1 class="fw-bold mb-1">
            <%= foundUser.username %>
          </h1>

          <p class="text-muted mb-1">
            <%= foundUser.bio?.trim() || "YelpCamp explorer and campground contributor." %>
          </p>

          <% if (foundUser.location) { %>
            <p class="mb-0">
              <i class="bi bi-house"></i>
              Based in <%= foundUser.location %>
            </p>
          <% } %>
        </div>

        <div class="profile-actions text-center text-md-end">
          <div class="d-flex justify-content-center justify-content-md-end gap-4 mb-3">
            <div>
              <div class="fw-bold fs-4"><%= totalCampgrounds %></div>
              <div class="text-muted small">Listings</div>
            </div>
            <div>
              <div class="fw-bold fs-4"><%= reviewCount%></div>
              <div class="text-muted small">Reviews</div>
            </div>
            <div>
              <div class="fw-bold fs-4"><%= favoriteCount%></div>
              <div class="text-muted small">Favorites</div>
            </div>
          </div>

          <% if (currUser && currUser._id.equals(foundUser._id)) { %>
            <a href="/users/<%= foundUser._id %>/edit" class="btn btn-outline-secondary">
              Edit Profile
            </a>
          <% } %>
        </div>
      </div>
  </div>
</div>
  </div>
  <div class="my-3 pb-1 border-bottom">
    <div>
      <h2 class="h4 fw-bold mb-1">
        Spaces hosted by <%= foundUser.username %>
      </h2>
    </div>
    <p class="text-muted mb-0">
      Places this user has shared with the community.
    </p>
  </div>
  <% if(campgrounds.length) {%>
    <div class="row g-4 mt-0">
      <% for (let campground of campgrounds) {%>
        <%- include('../partials/campgroundCard', { campground, favoriteIds }) %>
      <% } %>
    </div>
    <% if (totalCampgrounds > 6) {%>
      <div class="d-flex justify-content-center mb-3">
        <a href="/users/<%= foundUser._id %>/campgrounds" class="btn btn-dark">
          View All Listings
        </a>
      </div>
    <% } %>
  <% } else { %>
    <div class="text-center bg-light rounded-4 p-5">
      <i class="bi bi-tree fs-1 text-muted"></i>
      <h3 class="mt-3">No listings yet</h3>
      <p class="text-muted mb-0">
        This user has not shared any listings.
      </p>
    </div>
  <% } %>
</div>