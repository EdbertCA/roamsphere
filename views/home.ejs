<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RoamSphere</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/home.css">
</head>

<body class="d-flex  text-center text-white bg-dark">
  <div class="cover-container d-flex w-100 h-100 p-3 mx-auto flex-column">
    <header class="mb-auto mx-3">
      <div class="d-flex justify-content-between align-items-center">
        <h3>RoamSphere</h3>
        <nav class="nav nav-masthead">
          <a class="nav-link active" aria-current="page" href="#">Home</a>
          <a class="nav-link" href="/campgrounds">Listings</a>
          <% if (!currUser) {%>
            <a class="nav-link" href="/login">Login</a>
            <a class="nav-link" href="/register">Register</a>
          <% } else { %>
            <a class="nav-link" href="/logout">Logout</a>
          <% } %>
        </nav>
      </div>
    </header>
    <main class="px-3">
      <h1 >RoamSphere</h1>
      <p class="lead">Explore unique spaces, compare worldwide destinations, read reviews, and list your own property on a global marketplace.</p>
      <a href="/campgrounds" class="btn btn-lg btn-light fw-semibold">Explore Listings</a>
    </main>

    <footer class="mt-auto text-white-50">
      <p>&copy; RoamSphere 2026</p>
    </footer>
  </div>
      <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
        integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
        crossorigin="anonymous"></script>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
        integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
        crossorigin="anonymous"></script>
</body>

</html>