
<% layout('/layout/boilerplate') %>
<div class="row justify-content-center">
  <div class="col-md-6 text-center">
    <div class="alert alert-danger shadow border-0 p-4" style="border-radius: 12px;">
      <h1 class="display-5 fw-bold mb-3">Oops! Something went wrong</h1>
      <p class="lead text-muted mb-4"><%= err.message %></p>
      <a href="/campgrounds" class="btn btn-dark btn-lg fw-semibold btn-rounded">
          Back to Explore Listings
      </a>
      <% if (process.env.NODE_ENV !== 'production') { %>
          <div class="text-start mt-4 p-3 bg-white rounded border overflow-auto" style="max-height: 250px;">
              <pre class="m-0 small text-dark"><%= err.stack %></pre>
          </div>
      <% } %>
    </div>
  </div>
</div>