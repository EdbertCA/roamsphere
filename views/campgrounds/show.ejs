<% layout('/layout/boilerplate') %>
<link rel="stylesheet" href="/stylesheets/star.css">
<div class="row g-4">
  <div class="col-12 col-md-7">
    <div id="campgroundCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        <% campground.images.forEach((img, i)=> { %>
          <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
            <img class="d-block w-100 campground-img" src="<%= img.url %>" alt="">
          </div>
          <% }) %>
      </div>
      <% if (campground.images.length > 1) {%>
        <button class="carousel-control-prev" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
        <% } %>
    </div>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <div class="d-flex justify-content-between">
          <div>
          <h4 class="card-title mb-2">
            <%= campground.title %>
          </h4>
          <% if (campground.avgRating) { %>
            <div class="d-flex align-items-center gap-2 mb-3">
              <span class="badge rounded-pill fs-6 text-bg-light border">
                <i class="bi bi-star-fill text-warning me-1"></i>
                <%= campground.avgRating.toFixed(1) %>
              </span>
              <span class="text-muted">
                <%= campground.reviewCount %> review<%= campground.reviewCount === 1 ? '' : 's' %>
              </span>
            </div>
          <% } else { %>
            <p class="text-muted mb-2">
              No reviews yet
            </p>
          <% } %>
          </div>
          <div>
            <% if (currUser) { %>
              <% if (isFavorited) { %>
                <form action="/campgrounds/<%= campground._id %>/favorite?_method=DELETE" method="POST">
                  <button class="btn btn-outline-danger">
                    <i class="bi bi-heart-fill"></i> Remove Favorite
                  </button>
                </form>
              <% } else { %>
                <form action="/campgrounds/<%= campground._id %>/favorite" method="POST">
                  <button class="btn btn-outline-danger">
                    <i class="bi bi-heart"></i> Add to Favorites
                  </button>
                </form>
              <% } %>
            <% } %>
          </div>
        </div>
        <p class="text-muted mb-2">
          <i class="bi bi-geo-alt"></i>
          <%= campground.location %>
        </p>
        <% const isLongDescription=campground.description.length> 250; %>
        <p class="card-text campground-description">
          <% if (isLongDescription) { %>
          <span class="pe-1">
            <%= campground.description.substring(0, 250) %>
          </span>

          <span class="collapse" id="fullDescription">
            <%= campground.description.substring(250) %>
          </span>

          <button id="descriptionToggleBtn" class="btn btn-link p-0 text-decoration-none align-baseline" type="button"
            data-bs-toggle="collapse" data-bs-target="#fullDescription">
            Read more
          </button>

          <% } else { %>
            <%= campground.description %>
          <% } %>
        </p>
      </div>
      <div class="d-flex justify-content-between align-items-center border px-3 py-2">
        <div>
          <p class="mb-1 text-muted">Hosted by</p>
          <strong>
            <a href="/users/<%= campground.author._id %>" class="user-link fw-semibold text-decoration-none"><%= campground.author.username %></a>
          </strong>
        </div>

        <div class="text-end">
          <p class="mb-1 text-muted">Price</p>
          <strong>$<%= campground.price %>/night</strong>
        </div>
      </div>
      <% if (currUser && campground.author.equals(currUser._id)) { %>
        <div class="card-footer bg-white">
          <div class="d-flex justify-content-between align-items-center">
            <a class="btn btn-outline-primary px-4" href="/campgrounds/<%= campground._id %>/edit">Edit</a>
            <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
              <button class="btn btn-link text-danger text-decoration-none">
                Delete
              </button>
            </form>
          </div>
        </div>
        <% } %>
    </div>
  </div>

  <div class="col-12 col-md-5">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-0">
        <div id="map"></div>
      </div>
    </div>
    <% if(currUser) {%>
      <div class="card shadow-sm border-0 mb-4 mt-3">
        <div class="card-body">
          <h3 class="mb-3">Leave a Review</h3>
          <form action="/campgrounds/<%= campground._id %>/reviews" method="POST" class="validated-form" novalidate>
            <fieldset class="starability-basic mb-1">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
                aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <div class="mb-3">
              <label class="form-label" for="body">Review Comment</label>
              <textarea class="form-control" name="review[body]" id="body" cols="30" rows="4" required></textarea>
              <div class="valid-feedback">
                Looks good!
              </div>
            </div>
            <button class="btn btn-success w-100">Add a review</button>
          </form>
        </div>
      </div>
    <% } %>
    <div class="d-flex justify-content-between align-items-center px-2 mb-3">
      <h4 class="mb-0">Reviews</h4>

      <small class="text-muted">
        <%= campground.reviewCount %> <%= campground.reviewCount === 1 ? 'review' : 'reviews' %>
      </small>
    </div>
    <% const visibleReviews = campground.reviews.slice(0, 3); %>
    <% const hiddenReviews = campground.reviews.slice(3); %>
    <% for(let review of visibleReviews) {%>
      <div class="card mb-3 shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between mb-2">
            <div>
              <p class="card-subtitle mb-2 fw-semibold">
                <i class="bi bi-person-circle me-1"></i>
                <a href="/users/<%= review.author._id %>" class="user-link fw-semibold text-decoration-none"><%= review.author.username %></a>
              </p>
              <p class="starability-result" data-rating="<%= review.rating %>">
                Rated: <%= review.rating %> stars
              </p>
              
            </div>
            <% if(currUser && currUser.equals(review.author._id)) {%>
              <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            <% } %>
          </div>
          <p class="card-text">
            <%= review.body %>
          </p>
        </div>
      </div>
    <% } %>
    <% if (hiddenReviews.length) { %>
    <div class="collapse" id="moreReviews">
      <% for (let review of hiddenReviews) { %>
        <div class="card mb-3 shadow-sm border-0">
          <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
            <div>
              <p class="card-subtitle mb-2 fw-semibold">
                <i class="bi bi-person-circle me-1"></i>
                <%= review.author.username %>
              </p>
              <p class="starability-result" data-rating="<%= review.rating %>">
                Rated: <%= review.rating %> stars
              </p>
              
            </div>
            <% if(currUser && currUser.equals(review.author._id)) {%>
              <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST">
                <button class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            <% } %>
          </div>
          <p class="card-text">
            <%= review.body %>
          </p>
          </div>
        </div>
      <% } %>
    </div>

    <button 
      id="viewMoreBtn"
      class="btn btn-outline-secondary w-100 mb-3"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#moreReviews"
    >
      Show all reviews
    </button>
    <% } %>
  </div>
</div>

<%-"<script>"%>
  const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';
  const campground = <%- JSON.stringify(campground) %>;
<%-"</script>"%>
<script src="/javascripts/toggleBtn.js"></script>
<script src="/javascripts/showPageMap.js"></script>